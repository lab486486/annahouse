---
import { site } from "../site.config";
import "../styles/site.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: string;
  ogImage?: string;
  articlePublishedTime?: string;
}

const {
  title = site.title,
  description = site.description,
  noindex = false,
  ogType = "website",
  ogImage,
  articlePublishedTime,
} = Astro.props;

const pageTitle = title === site.title ? title : `${title} · ${site.brandName}`;
const canonical = new URL(Astro.url.pathname, site.baseUrl).href;
const resolvedOgImage = ogImage || new URL("/og.jpg", site.baseUrl).href;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href="/rss" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={site.brandName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    {articlePublishedTime && <meta property="article:publishedTime" content={articlePublishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#061128" />
    <meta name="application-name" content={site.brandName} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hahmlet:wght@600&display=swap" rel="stylesheet" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7643658138527330" crossorigin="anonymous"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <slot />
  </body>
</html>
