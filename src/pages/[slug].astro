---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { mediaUrl } from "../site.config";
import { renderPostHtml } from "../lib/render-post";
import legacyRedirects from "../data/legacy-redirects.json";
import { optimizedMedia } from "../utils/images";
import { formatDate, getBlogPosts, getSajuPosts, isSajuPost, postSlug, postUrl, relatedSajuPosts, type Post } from "../utils/posts";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  const postPaths = posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post, redirectTo: "" },
  }));
  const redirectPaths = Object.entries(legacyRedirects.ids).map(([id, slug]) => ({
    params: { slug: id },
    props: { post: undefined as unknown as Post, redirectTo: `/${slug}/` },
  }));
  return [...postPaths, ...redirectPaths];
}

interface Props {
  post?: Post;
  redirectTo?: string;
}

const { post, redirectTo } = Astro.props;
if (redirectTo) {
  return Astro.redirect(encodeURI(redirectTo), 301);
}
if (!post) {
  return Astro.redirect("/404/", 404);
}
const html = renderPostHtml(post.body || "");
const dateIso = post.data.date.toISOString().split("T")[0];
const ogImage = mediaUrl(post.data.cover_image);
const related = isSajuPost(post)
  ? await Promise.all(
      relatedSajuPosts(post, await getSajuPosts(), 3).map(async (item) => ({
        ...item,
        thumb: await optimizedMedia(mediaUrl(item.data.cover_image), 400, 400),
      })),
    )
  : [];
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={ogImage}
  articlePublishedTime={post.data.date.toISOString()}
>
  <Header fullBrand={isSajuPost(post)} />
  <main id="main" class="post-page">
    <div class="container post-wrap">
      <article class="post-article">
        <header class="post-header">
          <h1>{post.data.title}</h1>
          <p class="post-meta">
            <time datetime={dateIso}>{formatDate(post.data.date)}</time>
          </p>
        </header>
        <div class="post-body" set:html={html} />
        {
          related.length >= 2 && (
            <section class="related-saju" aria-labelledby="related-saju-heading">
              <h2 id="related-saju-heading">이어서 볼 사주</h2>
              <p>이 글을 끝까지 보셨다면, 관련 인물 사주도 이어서 읽어 보세요.</p>
              <ul class="related-saju-list">
                {related.map((item) => (
                  <li>
                    <a href={postUrl(item)}>
                      <div class="card-thumb">
                        {item.thumb ? (
                          <img src={item.thumb} alt="" width="400" height="400" loading="lazy" decoding="async" />
                        ) : (
                          <span>{(item.data.name || item.data.title).slice(0, 1)}</span>
                        )}
                      </div>
                      <strong>{item.data.name || item.data.title}</strong>
                      <span>{item.data.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </article>
      <aside class="post-side" aria-label="사이드바">
        <div
          class="ad-slot ad-unit ad-slot-side"
          aria-label="광고"
          data-ad-client="ca-pub-7643658138527330"
          data-ad-slot="6882189180"
          data-ad-format="fixed"
          data-ad-width="300"
          data-ad-height="600"
        ></div>
      </aside>
    </div>
  </main>
  <Footer />
</Layout>
