---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import draws from "../data/lotto-draws.json";
import { ballClass, formatKoDate, recommendLottoGames, type LottoDraw } from "../lib/lotto";

const history = draws as LottoDraw[];
const { games, latest } = recommendLottoGames(history);
const past = history.slice(0, 40);
---

<Layout title="로또" description="지난 회차와 이번 주 추천 번호 5게임을 봅니다.">
  <Header />
  <main id="main" class="page-plain">
    <div class="container lotto-page">
      <div class="lotto-wrap">
        <div class="lotto-main">
          <p class="eyebrow">로또 6/45</p>
          <h1>로또 번호</h1>
          <p class="lede">과거 이번 달에 당첨되었던 숫자와 미출현 숫자를 조합하여 번호를 추천합니다.</p>
          <p class="lede lotto-lede-follow">과연 이번주 추천 번호는 얼마나 적중할까요?</p>

          {
            latest && (
              <section class="result-box lotto-latest">
                <h2>지난 회차</h2>
                <p class="lotto-draw-meta">{latest.no}회 · {formatKoDate(latest.date)}</p>
                <p class="balls">
                  {latest.numbers.map((n) => <span class={ballClass(n)}>{n}</span>)}
                  <span class={`bonus ${ballClass(latest.bonus)}`}>+ {latest.bonus}</span>
                </p>
              </section>
            )
          }

          <section class="result-box lotto-picks">
            <h2>이번주 추천 번호</h2>
            <p class="lotto-note">당첨 확률을 올리지는 않습니다. 재미와 참고용입니다.</p>
            <ol class="lotto-games" id="lotto-games">
              {games.map((game) => (
                <li>
                  <p class="lotto-game-title">{game.title}</p>
                  <p class="lotto-game-blurb">{game.blurb}</p>
                  <p class="balls">
                    {game.numbers.map((n) => <span class={ballClass(n)}>{n}</span>)}
                  </p>
                </li>
              ))}
            </ol>
            <button class="primary-btn" id="lotto-again" type="button">다시 뽑기</button>
          </section>
        </div>

        <aside class="lotto-side" aria-label="과거 당첨 번호">
          <h2>과거 당첨 번호</h2>
          <ol class="lotto-history">
            {past.map((draw) => (
              <li>
                <p class="lotto-draw-meta">{draw.no}회 · {formatKoDate(draw.date)}</p>
                <p class="balls balls-sm">
                  {draw.numbers.map((n) => <span class={ballClass(n)}>{n}</span>)}
                  <span class={`bonus ${ballClass(draw.bonus)}`}>+ {draw.bonus}</span>
                </p>
              </li>
            ))}
          </ol>
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import draws from "../data/lotto-draws.json";
  import { ballClass, recommendLottoGames, type LottoDraw } from "../lib/lotto";

  const history = draws as LottoDraw[];
  const list = document.querySelector("#lotto-games");

  document.querySelector("#lotto-again")?.addEventListener("click", () => {
    const next = recommendLottoGames(history);
    if (!list) return;
    list.innerHTML = next.games.map((game) => `
      <li>
        <p class="lotto-game-title">${game.title}</p>
        <p class="lotto-game-blurb">${game.blurb}</p>
        <p class="balls">${game.numbers.map((n) => `<span class="${ballClass(n)}">${n}</span>`).join("")}</p>
      </li>
    `).join("");
  });
</script>
