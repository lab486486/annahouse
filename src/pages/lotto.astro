---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import draws from "../data/lotto-draws.json";
import { recommendLotto, type LottoDraw } from "../lib/lotto";

const history = draws as LottoDraw[];
const first = recommendLotto(history);
const latest = first.latest;
const recent = history.slice(0, 8);
---

<Layout title="로또" description="지난 회차와 통계로 뽑은 추천 번호를 봅니다.">
  <Header />
  <main id="main" class="page-plain">
    <div class="container">
      <p class="eyebrow">로또 6/45</p>
      <h1>로또 번호</h1>
      <p class="lede">지난 회차를 보여 주고, 같은 달·같은 주·최근 미출현 빈도로 번호 6개를 뽑습니다. 당첨 확률을 올리지 않습니다. 재미와 참고용입니다.</p>

      {
        latest && (
          <section class="result-box">
            <h2>{latest.no}회 · {latest.date}</h2>
            <p class="balls">
              {latest.numbers.map((n) => <span>{n}</span>)}
              <span class="bonus">+ {latest.bonus}</span>
            </p>
          </section>
        )
      }

      <section class="result-box">
        <h2>이번 추천</h2>
        <p class="balls" id="lotto-balls">
          {first.picks.map((pick) => <span title={pick.reasons.join(", ")}>{pick.number}</span>)}
        </p>
        <ul id="lotto-why">
          {first.picks.map((pick) => (
            <li>
              <strong>{pick.number}</strong> — {pick.reasons.join(" · ")}
            </li>
          ))}
        </ul>
        <button class="primary-btn" id="lotto-again" type="button">다시 뽑기</button>
      </section>

      <section class="home-block">
        <h2>최근 회차</h2>
        <table class="lotto-table">
          <thead>
            <tr><th>회차</th><th>날짜</th><th>번호</th></tr>
          </thead>
          <tbody>
            {recent.map((draw) => (
              <tr>
                <td>{draw.no}</td>
                <td>{draw.date}</td>
                <td>{draw.numbers.join(" · ")} + {draw.bonus}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import draws from "../data/lotto-draws.json";
  import { recommendLotto, type LottoDraw } from "../lib/lotto";

  const history = draws as LottoDraw[];
  const balls = document.querySelector("#lotto-balls");
  const why = document.querySelector("#lotto-why");

  document.querySelector("#lotto-again")?.addEventListener("click", () => {
    const next = recommendLotto(history);
    if (balls) {
      balls.innerHTML = next.picks.map((pick) => `<span title="${pick.reasons.join(", ")}">${pick.number}</span>`).join("");
    }
    if (why) {
      why.innerHTML = next.picks.map((pick) => `<li><strong>${pick.number}</strong> — ${pick.reasons.join(" · ")}</li>`).join("");
    }
  });
</script>
