---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { mediaUrl } from "../../site.config";
import legacyRedirects from "../../data/legacy-redirects.json";
import { formatDate, getBlogPosts, postUrl } from "../../utils/posts";

export function getStaticPaths() {
  return legacyRedirects.categories.map((category) => ({
    params: { cat: category.slug },
    props: { category },
  }));
}

interface Props {
  category: { slug: string; name: string };
}

const { category } = Astro.props;
const posts = (await getBlogPosts()).filter((post) => post.data.tags.includes(category.name));
---

<Layout title={category.name} description={`${category.name} 글을 모았습니다.`} noindex>
  <Header />
  <main id="main" class="page-plain">
    <div class="container">
      <p class="eyebrow">보관 글</p>
      <h1>{category.name}</h1>
      <p class="lede">예전에 올리던 글입니다. 주소는 그대로 열어 볼 수 있습니다.</p>
      {
        posts.length ? (
          <ul class="card-grid">
            {posts.map((post) => (
              <li>
                <a href={postUrl(post)}>
                  <div class="card-thumb">
                    {post.data.cover_image ? (
                      <img src={mediaUrl(post.data.cover_image)} alt="" />
                    ) : (
                      <span>{post.data.title.slice(0, 1)}</span>
                    )}
                  </div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p>이 분류에 글이 없습니다.</p>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>
