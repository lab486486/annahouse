---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { mediaUrl } from "../site.config";
import popular from "../data/popular.json";
import stars from "../data/stars.json";
import { celebrityFaces, formatDate, getBlogPosts, popularCards } from "../utils/posts";

const posts = await getBlogPosts();
const postFaces = celebrityFaces(posts, popular.slugs).map((face) => ({
  ...face,
  image: mediaUrl(face.image) || "",
}));
const popularFaces = popularCards(posts, popular.slugs, 6).map((face) => ({
  ...face,
  image: mediaUrl(face.image) || "",
}));
const fallbackFaces = stars.map((star) => ({
  name: star.name,
  href: `/saju/star/?name=${encodeURIComponent(star.name)}`,
  image: "",
  title: `${star.name} 사주`,
  description: "스타와 궁합에서 생일을 맞춰 볼 수 있습니다.",
  date: undefined as Date | undefined,
}));
const faces = postFaces.length ? postFaces : fallbackFaces;
const ticker = [...faces, ...faces];
const cards = popularFaces.length ? popularFaces : postFaces.slice(0, 6);
const marqueeSeconds = Math.max(42, faces.length * 1.6);
const starsTwinkle = [
  [8, 12, 1.6, 0],
  [14, 22, 1.1, 0.8],
  [22, 9, 2.2, 1.4],
  [28, 18, 1.3, 0.3],
  [18, 28, 0.9, 1.1],
  [6, 32, 1.4, 1.8],
  [33, 14, 1.8, 0.5],
  [11, 8, 1.0, 2.1],
  [25, 26, 1.2, 0.2],
  [16, 16, 2.0, 1.6],
  [4, 20, 1.1, 0.9],
  [31, 6, 1.5, 2.4],
  [20, 11, 0.8, 0.4],
  [9, 24, 1.7, 1.3],
  [36, 20, 1.0, 2.0],
] as const;
---

<Layout>
  <main id="main">
    <section class="hero-portal">
      <div class="hero-sky" aria-hidden="true">
        {starsTwinkle.map(([left, top, size, delay]) => (
          <span
            class="hero-star"
            style={`left:${left}%;top:${top}%;width:${size}px;height:${size}px;animation-delay:${delay}s`}
          />
        ))}
      </div>
      <Header overlay />
      <div class="hero-portal-inner container">
        <h1>하늘이 맺어준 소중한 인연</h1>
        <p class="lede">유명인의 이름을 입력해보세요!</p>
        <form class="search-box" id="home-search" action="/saju/" method="get">
          <label class="sr-only" for="q">사주 검색</label>
          <input id="q" name="q" type="search" placeholder="아이유, 손흥민…" autocomplete="off" />
          <button type="submit">검색</button>
        </form>
      </div>
      <div class="face-marquee" aria-label="인기 사주 대상">
        <div class="face-track" style={`animation-duration: ${marqueeSeconds}s`}>
          {
            ticker.map((face) => (
              <a class="face" href={face.href} data-name={face.name}>
                {face.image ? <img src={face.image} alt="" /> : <span>{face.name.slice(0, 1)}</span>}
                <em>{face.name}</em>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="container home-block">
      <div class="block-head">
        <h2>지금 많이 찾는 사주</h2>
        <a href="/saju/">전체보기</a>
      </div>
      {
        cards.length ? (
          <ul class="card-grid card-grid-featured">
            {cards.map((card) => (
              <li>
                <a href={card.href}>
                  <div class="card-thumb">{card.image ? <img src={card.image} alt="" /> : <span>{card.name.slice(0, 1)}</span>}</div>
                  <h3>{card.title}</h3>
                  <p>{card.description}</p>
                  {card.date && <time datetime={card.date.toISOString()}>{formatDate(card.date)}</time>}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <ul class="card-grid card-grid-featured">
            {fallbackFaces.slice(0, 6).map((card) => (
              <li>
                <a href={card.href}>
                  <div class="card-thumb"><span>{card.name.slice(0, 1)}</span></div>
                  <h3>{card.name}</h3>
                  <p>{card.description}</p>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("#home-search");
  const input = document.querySelector<HTMLInputElement>("#q");
  const faces = [...document.querySelectorAll<HTMLAnchorElement>(".face")];

  form?.addEventListener("submit", (event) => {
    const q = (input?.value || "").trim();
    const hit = faces.find((el) => (el.dataset.name || "") === q);
    if (hit) {
      event.preventDefault();
      window.location.href = hit.href;
    }
  });
</script>
