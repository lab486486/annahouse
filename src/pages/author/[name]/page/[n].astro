---
import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import AuthorArchive from "../../../../components/AuthorArchive.astro";
import author from "../../../../data/authors.json";
import { getBlogPosts, paginatePosts } from "../../../../utils/posts";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / author.pageSize));
  return Array.from({ length: totalPages }, (_, index) => ({
    params: { name: author.slug, n: String(index + 1) },
  }));
}

const page = Number(Astro.params.n) || 1;
const posts = await getBlogPosts();
const listing = paginatePosts(posts, page, author.pageSize);
---

<Layout title={`${author.name} 글 ${listing.page}페이지`} description={`${author.name}이 올린 글 ${listing.page}페이지입니다.`}>
  <Header />
  <main id="main" class="page-plain">
    <div class="container">
      <AuthorArchive
        displayName={author.name}
        slug={author.slug}
        page={listing.page}
        totalPages={listing.totalPages}
        posts={listing.items}
      />
    </div>
  </main>
  <Footer />
</Layout>
