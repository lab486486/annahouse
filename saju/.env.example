# 워드프레스 (saju/main.py 옛 경로만 필요. Git 발행기는 쓰지 않음)
WP_SITE_URL=https://your-site.com
WP_USERNAME=admin
WP_APP_PASSWORD=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=false
# DEEPSEEK_MAX_TOKENS=24000
# DEEPSEEK_TIMEOUT=240

# 피크타임 회피 (KST 10-13, 15-19)
PEAK_AVOIDANCE_ENABLED=true
PEAK_AVOIDANCE_MODE=skip
PEAK_SCHEDULE_ADJUST=true
PEAK_AVOIDANCE_TZ=Asia/Seoul
